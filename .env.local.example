# Copier ce fichier en .env.local et renseigner les valeurs depuis
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service role key : uniquement pour le script de seed (scripts/seed.ts),
# jamais utilisée côté client, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facultatif : code du WEI / PIN orga utilisés par `npm run seed`
# (par défaut WEI2026 / 1234 si absents).
SEED_WEI_CODE=WEI2026
SEED_ORGA_PIN=1234
